# Local development against a sibling Astrelis checkout.
#
# The workspace pins Astrelis to an exact git revision so CI and fresh clones
# resolve one reproducible tree. Copy this file to `.cargo/config.toml` (which
# is gitignored) to redirect every Astrelis crate to `../astrelis` instead:
#
#   git clone https://github.com/hxyulin/astrelis ../astrelis
#   cp .cargo/config.toml.example .cargo/config.toml
#
# Only the crates RXUI declares in `[workspace.dependencies]` need patching;
# Astrelis resolves its own internal dependencies from within the checkout.
#
# Keep this list in sync with `[workspace.dependencies]` in Cargo.toml.
[patch."https://github.com/hxyulin/astrelis"]
astrelis-app = { path = "../astrelis/crates/astrelis-app" }
astrelis-compositor = { path = "../astrelis/crates/astrelis-compositor" }
astrelis-core = { path = "../astrelis/crates/astrelis-core" }
astrelis-gpu = { path = "../astrelis/crates/astrelis-gpu" }
astrelis-paint = { path = "../astrelis/crates/astrelis-paint" }
astrelis-paint-gpu = { path = "../astrelis/crates/astrelis-paint-gpu" }
astrelis-platform = { path = "../astrelis/crates/astrelis-platform" }
astrelis-platform-winit = { path = "../astrelis/crates/astrelis-platform-winit" }
astrelis-text = { path = "../astrelis/crates/astrelis-text" }
astrelis-ui-host = { path = "../astrelis/crates/astrelis-ui-host" }
astrelis-ui-next = { path = "../astrelis/crates/astrelis-ui-next" }
